<UserControl x:Class="Salvo.App.Views.Flow.GroupFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Salvo.App.ViewModels"
             xmlns:fvm="clr-namespace:Salvo.App.ViewModels.Flow"
             xmlns:conv="clr-namespace:Salvo.App.Converters"
             xmlns:loc="clr-namespace:Salvo.App.Localization"
             AllowDrop="True"
             DragOver="UserControl_OnDragOver"
             Drop="UserControl_OnDrop">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="NotBoolToVisibility" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NotNullToVisibility" Invert="True" />
        <conv:RunningStateBrushConverter x:Key="RunningBrush" />
        <conv:RunningStateAppearanceConverter x:Key="PlayAppearance" RunningAppearance="Secondary" StoppedAppearance="Primary" />
        <conv:RunningStateAppearanceConverter x:Key="StopAppearance" RunningAppearance="Primary" StoppedAppearance="Secondary" />

        <!-- ============ Node row templates ============ -->
        <!-- Every row is full-width inside its container and renders a
             single graph node. Apps get the rich row from the legacy
             Detailed view; control-flow nodes get slimmer, distinct
             chrome so the eye can pick them out at a glance. -->

        <Style x:Key="NodeRowBase" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMergeTarget}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact control-flow row (Wait, If, ServiceStart, etc.) -->
        <Style x:Key="ControlRowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMergeTarget}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- StartNode row: small accent banner so the user can see "this is where it starts" -->
        <DataTemplate DataType="{x:Type fvm:StartNodeViewModel}">
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="10" Padding="10,2">
                        <TextBlock Text="START"
                                   FontWeight="SemiBold" FontSize="11"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="Run order begins here"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- AppNode row: rich row mirroring the legacy Detailed view -->
        <DataTemplate DataType="{x:Type fvm:AppNodeViewModel}">
            <Border Style="{StaticResource NodeRowBase}" Height="64">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="10" Height="10"
                             VerticalAlignment="Center" Margin="0,0,14,0"
                             Fill="{Binding App.IsRunning, Converter={StaticResource RunningBrush}}" />

                    <Grid Grid.Column="1" Width="32" Height="32"
                          VerticalAlignment="Center" Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="Apps24" FontSize="22"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding App.Icon, Converter={StaticResource NullToVisibility}}" />
                        <Image Source="{Binding App.Icon}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding App.Icon, Converter={StaticResource NotNullToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding App.Name}"
                                   FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="3" Padding="6,1">
                                <TextBlock Text="{Binding App.Kind}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,16,0">
                        <TextBlock TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="12">
                            <TextBlock.Text>
                                <PriorityBinding>
                                    <Binding Path="App.Path" FallbackValue="" />
                                    <Binding Path="App.Service" FallbackValue="" />
                                </PriorityBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding App.Args}"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding App.Args, Converter={StaticResource NotNullToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="{Binding App.IsRunning, Converter={StaticResource PlayAppearance}}"
                                   Icon="{ui:SymbolIcon Play24}"
                                   ToolTip="{loc:Translate Action_Launch}"
                                   IsEnabled="{Binding App.IsStopped}"
                                   Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding App}"
                                   Margin="0,0,6,0" />
                        <ui:Button Appearance="{Binding App.IsRunning, Converter={StaticResource StopAppearance}}"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   ToolTip="{loc:Translate Action_Stop}"
                                   IsEnabled="{Binding App.IsRunning}"
                                   Command="{Binding DataContext.StopAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding App}"
                                   Margin="0,0,6,0" />
                        <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                   Appearance="Transparent"
                                   ToolTip="{loc:Translate Action_Edit}"
                                   Command="{Binding DataContext.EditAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding App}"
                                   Margin="0,0,6,0" />
                        <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                   Appearance="Transparent"
                                   ToolTip="{loc:Translate Action_Remove}"
                                   Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- WaitNode row -->
        <DataTemplate DataType="{x:Type fvm:WaitNodeViewModel}">
            <Border Style="{StaticResource ControlRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Timer24" FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Wait" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:NumberBox Value="{Binding DurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Minimum="0" Maximum="3600"
                                      Width="90" Margin="10,0,0,0" />
                        <TextBlock Text="seconds before the next item runs"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Transparent"
                               Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- IfElseNode row (condition editor inline) -->
        <DataTemplate DataType="{x:Type fvm:IfElseNodeViewModel}">
            <Border Style="{StaticResource ControlRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="BranchFork24" FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="If" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Condition.DisplayName}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Transparent"
                               Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ServiceStartNode row -->
        <DataTemplate DataType="{x:Type fvm:ServiceStartNodeViewModel}">
            <Border Style="{StaticResource ControlRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Play24" FontSize="20"
                                   Foreground="#16A34A"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Start service" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ServiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" Margin="10,0,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Transparent"
                               Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ServiceStopNode row -->
        <DataTemplate DataType="{x:Type fvm:ServiceStopNodeViewModel}">
            <Border Style="{StaticResource ControlRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Stop24" FontSize="20"
                                   Foreground="#DC2626"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Stop service" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ServiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" Margin="10,0,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Transparent"
                               Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- RunCommandNode row -->
        <DataTemplate DataType="{x:Type fvm:RunCommandNodeViewModel}">
            <Border Style="{StaticResource ControlRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="WindowConsole20" FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Run" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="110" Margin="10,0,0,0"
                                  SelectedValue="{Binding Interpreter, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Tag="shell">Shell</ComboBoxItem>
                            <ComboBoxItem Tag="powershell">PowerShell</ComboBoxItem>
                            <ComboBoxItem Tag="direct">Direct</ComboBoxItem>
                        </ComboBox>
                        <TextBox Grid.Column="2"
                                 Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"
                                 Margin="10,0,0,0" />
                    </Grid>
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Transparent"
                               Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- GroupCallNode row -->
        <DataTemplate DataType="{x:Type fvm:GroupCallNodeViewModel}">
            <Border Style="{StaticResource ControlRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="FolderArrowRight24" FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Run group" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding DataContext.AllGroups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  SelectedValue="{Binding GroupId, Mode=TwoWay}"
                                  Width="280" Margin="10,0,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Transparent"
                               Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Per-stage "+ Insert below" affordance shown after every stage.
             Tag carries the stage so the Click handler in code-behind can
             route to MainWindowViewModel.InsertNodeAfterStage(stage, kind). -->
        <Style x:Key="InsertBelowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="11"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Stage template ============ -->
        <!-- A stage with one node renders that node inline; a stage with
             multiple nodes wraps them in a "Parallel" container so the
             user sees the concurrency at a glance. Both render a
             "+ Insert below" button after the content for inserts. -->
        <DataTemplate DataType="{x:Type fvm:StageViewModel}">
            <StackPanel AllowDrop="True"
                        Background="Transparent"
                        DragOver="Stage_OnDragOver"
                        DragLeave="Stage_OnDragLeave"
                        Drop="Stage_OnDrop">
                <Grid>
                    <!-- Single-node stage: just the row -->
                    <ItemsControl ItemsSource="{Binding Nodes}"
                                  Visibility="{Binding IsParallel, Converter={StaticResource NotBoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Parallel stage: indented wrapper with header + sub-rows -->
                    <Border Visibility="{Binding IsParallel, Converter={StaticResource BoolToVisibility}}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="3,0,0,0"
                            Margin="16,4,0,4">
                        <StackPanel>
                            <Grid Margin="14,8,16,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Flash24" FontSize="14"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="Run in parallel"
                                               Margin="6,0,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Nodes.Count, StringFormat=({0} items)}"
                                               Margin="6,0,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:Button Grid.Column="1"
                                           Appearance="Transparent"
                                           Padding="8,2"
                                           FontSize="11"
                                           ToolTip="Convert this parallel block into a sequential chain"
                                           Command="{Binding DataContext.MakeStageSequentialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSort24" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Make sequential" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- "+ Insert below" button. Tag = the stage; menu items
                     carry kind in Tag, code-behind routes them. -->
                <Button Style="{StaticResource InsertBelowButton}"
                        Tag="{Binding}"
                        Click="InsertBelow_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="Insert below" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="App" Tag="App" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Apps24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Wait" Tag="Wait" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Timer24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="If / Else" Tag="IfElse" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="BranchFork24" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Start service" Tag="ServiceStart" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Play24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Stop service" Tag="ServiceStop" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Stop24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Run command" Tag="RunCommand" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="WindowConsole20" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Call group" Tag="GroupCall" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderArrowRight24" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: Add node menu -->
        <Border Grid.Row="0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <ui:DropDownButton Content="Add item"
                               Icon="{ui:SymbolIcon Add24}"
                               Appearance="Primary"
                               HorizontalAlignment="Left">
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Header="App"
                                  Command="{Binding AddNodeCommand}"
                                  CommandParameter="App">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Apps24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Wait"
                                  Command="{Binding AddNodeCommand}"
                                  CommandParameter="Wait">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Timer24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="If / Else"
                                  Command="{Binding AddNodeCommand}"
                                  CommandParameter="IfElse">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="BranchFork24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Start service"
                                  Command="{Binding AddNodeCommand}"
                                  CommandParameter="ServiceStart">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Play24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Stop service"
                                  Command="{Binding AddNodeCommand}"
                                  CommandParameter="ServiceStop">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Stop24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Run command"
                                  Command="{Binding AddNodeCommand}"
                                  CommandParameter="RunCommand">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="WindowConsole20" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Call group"
                                  Command="{Binding AddNodeCommand}"
                                  CommandParameter="GroupCall">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="FolderArrowRight24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </Border>

        <!-- Vertical list of stages. The Rectangle overlay sibling is the
             single global insertion-line indicator; we move it to the
             closest snap point during drag from code-behind, so the user
             sees one stable bar instead of competing per-stage bars. -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="StageScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="StageList"
                              ItemsSource="{Binding SelectedGroup.Graph.Stages}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <Rectangle x:Name="InsertionLine"
                       Height="3"
                       Margin="20,0"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Stretch"
                       Fill="{DynamicResource AccentFillColorDefaultBrush}"
                       RadiusX="2" RadiusY="2"
                       Visibility="Collapsed"
                       IsHitTestVisible="False">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="InsertionLineTransform" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </Grid>
</UserControl>
