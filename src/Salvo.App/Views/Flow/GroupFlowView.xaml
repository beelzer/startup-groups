<UserControl x:Class="Salvo.App.Views.Flow.GroupFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Salvo.App.ViewModels"
             xmlns:fvm="clr-namespace:Salvo.App.ViewModels.Flow"
             xmlns:conv="clr-namespace:Salvo.App.Converters"
             xmlns:loc="clr-namespace:Salvo.App.Localization"
             AllowDrop="True"
             PreviewDragOver="Root_OnPreviewDragOver"
             DragOver="UserControl_OnDragOver"
             Drop="UserControl_OnDrop">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="NotBoolToVisibility" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NotNullToVisibility" Invert="True" />
        <conv:RunningStateBrushConverter x:Key="RunningBrush" />
        <conv:RunningStateAppearanceConverter x:Key="PlayAppearance" RunningAppearance="Secondary" StoppedAppearance="Primary" />
        <conv:RunningStateAppearanceConverter x:Key="StopAppearance" RunningAppearance="Primary" StoppedAppearance="Secondary" />

        <!-- ============ Node row templates ============ -->
        <!-- Every row is full-width inside its container and renders a
             single graph node. Apps get the rich row from the legacy
             Detailed view; control-flow nodes get slimmer, distinct
             chrome so the eye can pick them out at a glance. -->

        <Style x:Key="NodeRowBase" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMergeTarget}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact control-flow row (Wait, If, ServiceStart, etc.) -->
        <Style x:Key="ControlRowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMergeTarget}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- StartNode row: tiny accent pill, no helper sentence (the
             top-of-list position already implies "things start here"). -->
        <DataTemplate DataType="{x:Type fvm:StartNodeViewModel}">
            <Border Padding="16,4">
                <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="8" Padding="8,1"
                        HorizontalAlignment="Left">
                    <TextBlock Text="START"
                               FontWeight="SemiBold" FontSize="10"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </Border>
        </DataTemplate>

        <!-- AppNode row: rich row mirroring the legacy Detailed view -->
        <DataTemplate DataType="{x:Type fvm:AppNodeViewModel}">
            <Border Style="{StaticResource NodeRowBase}" Height="64">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="10" Height="10"
                             VerticalAlignment="Center" Margin="0,0,14,0"
                             Fill="{Binding App.IsRunning, Converter={StaticResource RunningBrush}}" />

                    <Grid Grid.Column="1" Width="32" Height="32"
                          VerticalAlignment="Center" Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="Apps24" FontSize="22"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding App.Icon, Converter={StaticResource NullToVisibility}}" />
                        <Image Source="{Binding App.Icon}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding App.Icon, Converter={StaticResource NotNullToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding App.Name}"
                                   FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="3" Padding="6,1">
                                <TextBlock Text="{Binding App.Kind}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,16,0">
                        <TextBlock TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="12">
                            <TextBlock.Text>
                                <PriorityBinding>
                                    <Binding Path="App.Path" FallbackValue="" />
                                    <Binding Path="App.Service" FallbackValue="" />
                                </PriorityBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding App.Args}"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding App.Args, Converter={StaticResource NotNullToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="{Binding App.IsRunning, Converter={StaticResource PlayAppearance}}"
                                   Icon="{ui:SymbolIcon Play24}"
                                   ToolTip="{loc:Translate Action_Launch}"
                                   IsEnabled="{Binding App.IsStopped}"
                                   Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding App}"
                                   Margin="0,0,6,0" />
                        <ui:Button Appearance="{Binding App.IsRunning, Converter={StaticResource StopAppearance}}"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   ToolTip="{loc:Translate Action_Stop}"
                                   IsEnabled="{Binding App.IsRunning}"
                                   Command="{Binding DataContext.StopAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding App}"
                                   Margin="0,0,6,0" />
                        <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                   Appearance="Transparent"
                                   ToolTip="{loc:Translate Action_Edit}"
                                   Command="{Binding DataContext.EditAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding App}"
                                   Margin="0,0,6,0" />
                        <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                   Appearance="Transparent"
                                   ToolTip="{loc:Translate Action_Remove}"
                                   Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- WaitNode row -->
        <DataTemplate DataType="{x:Type fvm:WaitNodeViewModel}">
            <Border Style="{StaticResource ControlRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Timer24" FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Wait" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:NumberBox Value="{Binding DurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Minimum="0" Maximum="3600"
                                      AllowDrop="False"
                                      LostFocus="NodeField_OnChanged"
                                      Width="90" Margin="10,0,0,0" />
                        <TextBlock Text="seconds before the next item runs"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Transparent"
                               Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Compact always-visible "+ add" pill used inside If branches.
             Unlike InsertBelowButton it's not hover-gated — a branch needs
             a discoverable way to add its first step. -->
        <Style x:Key="BranchAddButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="11"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Reusable per-branch add menu. Excludes "If / Else" — nested
             branches aren't supported in the Simple view yet. -->
        <ContextMenu x:Key="BranchKindMenu" x:Shared="False" Placement="Bottom">
            <MenuItem Header="App" Tag="App" Click="BranchAddMenu_OnClick">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Apps24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Wait" Tag="Wait" Click="BranchAddMenu_OnClick">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Timer24" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Start service" Tag="ServiceStart" Click="BranchAddMenu_OnClick">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Play24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Stop service" Tag="ServiceStop" Click="BranchAddMenu_OnClick">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Stop24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Run command" Tag="RunCommand" Click="BranchAddMenu_OnClick">
                <MenuItem.Icon><ui:SymbolIcon Symbol="WindowConsole20" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Call group" Tag="GroupCall" Click="BranchAddMenu_OnClick">
                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderArrowRight24" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Branch body: the "Then" / "Else" section shared shape. The
             DataContext is the IfElseNodeViewModel; ContentControl.Content
             is bound per-use to ThenNodes / ElseNodes via the host. -->

        <!-- IfElseNode row: condition header + Then / Else branch bodies.
             The If is a single opaque node in the outer chain; each branch
             holds its own linear sequence of child nodes, expanded into
             then/else-labeled edges on save (GroupGraphViewModel.WriteTo).
             Node rows inside a branch reuse the per-type node templates. -->
        <DataTemplate DataType="{x:Type fvm:IfElseNodeViewModel}">
            <Border Style="{StaticResource NodeRowBase}" Padding="16,10">
                <StackPanel>
                    <!-- Condition header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="BranchFork24" FontSize="20"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Grid Grid.Column="1" Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="If" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Width="160" Margin="10,0,0,0" VerticalAlignment="Center"
                                      AllowDrop="False"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding ConditionKind, Mode=TwoWay}"
                                      DropDownClosed="NodePicker_OnClosed">
                                <ComboBoxItem Tag="serviceRunning">Service running</ComboBoxItem>
                                <ComboBoxItem Tag="fileExists">File exists</ComboBoxItem>
                                <ComboBoxItem Tag="processRunning">Process running</ComboBoxItem>
                            </ComboBox>
                            <ui:TextBox Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        AllowDrop="False"
                                        PlaceholderText="{Binding Condition.ValueLabel}"
                                        Text="{Binding Condition.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        LostFocus="NodeField_OnChanged" />
                        </Grid>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                                   Appearance="Transparent"
                                   Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </Grid>

                    <!-- Then branch (drop target for dragged nodes) -->
                    <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="3,0,0,0" Margin="8,8,0,0" Padding="12,4,0,4"
                            Tag="then" AllowDrop="True"
                            DragOver="Branch_OnDragOver" DragLeave="Branch_OnDragLeave" Drop="Branch_OnDrop">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThenIsDropTarget}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Then" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <ItemsControl ItemsSource="{Binding ThenNodes}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="Nothing here yet — add a step."
                                       FontSize="11" FontStyle="Italic"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding ThenIsEmpty, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource BranchAddButton}"
                                    Tag="then"
                                    ContextMenu="{StaticResource BranchKindMenu}"
                                    Click="BranchAdd_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="Add to Then" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Else branch (drop target for dragged nodes) -->
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="3,0,0,0" Margin="8,6,0,0" Padding="12,4,0,4"
                            Tag="else" AllowDrop="True"
                            DragOver="Branch_OnDragOver" DragLeave="Branch_OnDragLeave" Drop="Branch_OnDrop">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElseIsDropTarget}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Else" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding ElseNodes}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="Nothing here yet — add a step."
                                       FontSize="11" FontStyle="Italic"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding ElseIsEmpty, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource BranchAddButton}"
                                    Tag="else"
                                    ContextMenu="{StaticResource BranchKindMenu}"
                                    Click="BranchAdd_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="Add to Else" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ServiceStartNode row -->
        <DataTemplate DataType="{x:Type fvm:ServiceStartNodeViewModel}">
            <Border Style="{StaticResource ControlRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Play24" FontSize="20"
                                   Foreground="#16A34A"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Start service" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ServiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AllowDrop="False"
                                 LostFocus="NodeField_OnChanged"
                                 Width="220" Margin="10,0,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Transparent"
                               Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ServiceStopNode row -->
        <DataTemplate DataType="{x:Type fvm:ServiceStopNodeViewModel}">
            <Border Style="{StaticResource ControlRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Stop24" FontSize="20"
                                   Foreground="#DC2626"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Stop service" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ServiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AllowDrop="False"
                                 LostFocus="NodeField_OnChanged"
                                 Width="220" Margin="10,0,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Transparent"
                               Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- RunCommandNode row -->
        <DataTemplate DataType="{x:Type fvm:RunCommandNodeViewModel}">
            <Border Style="{StaticResource ControlRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="WindowConsole20" FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Run" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="110" Margin="10,0,0,0"
                                  AllowDrop="False"
                                  SelectedValue="{Binding Interpreter, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  DropDownClosed="NodePicker_OnClosed">
                            <ComboBoxItem Tag="shell">Shell</ComboBoxItem>
                            <ComboBoxItem Tag="powershell">PowerShell</ComboBoxItem>
                            <ComboBoxItem Tag="direct">Direct</ComboBoxItem>
                        </ComboBox>
                        <TextBox Grid.Column="2"
                                 AllowDrop="False"
                                 Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"
                                 LostFocus="NodeField_OnChanged"
                                 Margin="10,0,16,0" />
                    </Grid>
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Transparent"
                               Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- GroupCallNode row -->
        <DataTemplate DataType="{x:Type fvm:GroupCallNodeViewModel}">
            <Border Style="{StaticResource ControlRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="FolderArrowRight24" FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Run group" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding DataContext.AllGroups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  SelectedValue="{Binding GroupId, Mode=TwoWay}"
                                  DropDownClosed="NodePicker_OnClosed"
                                  Width="280" Margin="10,0,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Transparent"
                               Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Per-stage "+ Insert below" affordance shown after every stage.
             Tag carries the stage so the Click handler in code-behind can
             route to MainWindowViewModel.InsertNodeAfterStage(stage, kind).
             Hidden until the parent stage StackPanel is hovered, so the
             resting view stays clean. Hit-testing follows opacity so a
             phantom click can't land on the invisible button. -->
        <Style x:Key="InsertBelowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="11"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Stage template ============ -->
        <!-- A stage with one node renders that node inline; a stage with
             multiple nodes wraps them in a "Parallel" container so the
             user sees the concurrency at a glance. Both render a
             "+ Insert below" button after the content for inserts. -->
        <DataTemplate DataType="{x:Type fvm:StageViewModel}">
            <StackPanel AllowDrop="True"
                        Background="Transparent"
                        DragOver="Stage_OnDragOver"
                        DragLeave="Stage_OnDragLeave"
                        Drop="Stage_OnDrop">
                <Grid>
                    <!-- Single-node stage: just the row -->
                    <ItemsControl ItemsSource="{Binding Nodes}"
                                  Visibility="{Binding IsParallel, Converter={StaticResource NotBoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Parallel stage: indented accent bracket with a
                         compact "Run in parallel (N items)" header.
                         "Make sequential" lives in the right-click menu
                         on the block (was an inline button — moving it
                         to a right-click reduces visual chrome without
                         losing the action). -->
                    <Border Visibility="{Binding IsParallel, Converter={StaticResource BoolToVisibility}}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="3,0,0,0"
                            Margin="16,4,0,4">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Make sequential"
                                          Command="{Binding DataContext.MakeStageSequentialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSort24" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="14,8,16,6"
                                        VerticalAlignment="Center"
                                        ToolTip="Right-click for options">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="14"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="Run in parallel"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Nodes.Count, StringFormat=({0} items)}"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- "+ Insert below" button. Tag = the stage; menu items
                     carry kind in Tag, code-behind routes them. -->
                <Button Style="{StaticResource InsertBelowButton}"
                        Tag="{Binding}"
                        Click="InsertBelow_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="Insert below" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="App" Tag="App" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Apps24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Wait" Tag="Wait" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Timer24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="If / Else" Tag="IfElse" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="BranchFork24" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Start service" Tag="ServiceStart" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Play24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Stop service" Tag="ServiceStop" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Stop24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Run command" Tag="RunCommand" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="WindowConsole20" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Call group" Tag="GroupCall" Click="InsertMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderArrowRight24" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Vertical list of stages. The Rectangle overlay sibling is the
         single global insertion-line indicator; we move it to the
         closest snap point during drag from code-behind, so the user
         sees one stable bar instead of competing per-stage bars. The
         StackPanel-around-ItemsControl pattern lets us pin a single
         always-visible trailing "+ Add item" affordance below the
         stages, since the per-stage inserts are now hover-only. -->
    <Grid>
        <ScrollViewer x:Name="StageScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl x:Name="StageList"
                              ItemsSource="{Binding SelectedGroup.Graph.Stages}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Trailing always-visible add affordance. Routed through
                     the same per-kind context menu as the in-list inserts
                     so the user has a single mental model for "what can
                     I add". -->
                <Button x:Name="TrailingAddButton"
                        Click="TrailingAdd_OnClick"
                        Margin="0,8,0,16"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        FontSize="11"
                        Padding="12,6">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="13"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="Add item" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="App" Tag="App" Click="TrailingAddMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Apps24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Wait" Tag="Wait" Click="TrailingAddMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Timer24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="If / Else" Tag="IfElse" Click="TrailingAddMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="BranchFork24" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Start service" Tag="ServiceStart" Click="TrailingAddMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Play24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Stop service" Tag="ServiceStop" Click="TrailingAddMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Stop24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Run command" Tag="RunCommand" Click="TrailingAddMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="WindowConsole20" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Call group" Tag="GroupCall" Click="TrailingAddMenu_OnClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderArrowRight24" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Rectangle x:Name="InsertionLine"
                       Height="3"
                       Margin="20,0"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Stretch"
                       Fill="{DynamicResource AccentFillColorDefaultBrush}"
                       RadiusX="2" RadiusY="2"
                       Visibility="Collapsed"
                       IsHitTestVisible="False">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="InsertionLineTransform" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</UserControl>
