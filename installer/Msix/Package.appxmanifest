<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Salvo package.

  - Identity Name + Publisher are placeholders pending Partner Center
    reservation. Once reserved, swap Publisher to the CN= value Microsoft
    issues in Partner Center, and (for Store builds) keep Identity Name
    matching the reserved app name. Sideload builds keep their own
    Publisher matching the signing cert subject.
  - Version is the MSIX 4-part W.X.Y.Z. Z stays 0 (Store reserves the
    revision field). Build pipeline rewrites this from
    Directory.Build.props at pack time.
  - Windows.FullTrustApplication + rescap:runFullTrust together declare
    this as a packaged Win32 desktop app. Existing %AppData% paths,
    registry access, UAC elevation, and WPF + Mica all keep working as
    they do in the unpackaged build.
  - Min target 10.0.17763.0 (Windows 10 1809 — first version with stable
    full-trust MSIX support). Max tested 10.0.26100.0 (Windows 11 24H2).
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap5 rescap">

    <Identity Name="Salvo"
              Publisher="CN=SalvoDev"
              Version="0.2.14.0"
              ProcessorArchitecture="x64" />

    <Properties>
        <DisplayName>Salvo</DisplayName>
        <PublisherDisplayName>Salvo</PublisherDisplayName>
        <Logo>Images\StoreLogo.png</Logo>
        <Description>Coordinated, readiness-gated launcher for your Windows startup apps.</Description>
    </Properties>

    <Dependencies>
        <TargetDeviceFamily Name="Windows.Desktop"
                            MinVersion="10.0.17763.0"
                            MaxVersionTested="10.0.26100.0" />
    </Dependencies>

    <Resources>
        <Resource Language="en-US" />
    </Resources>

    <Applications>
        <Application Id="App"
                     Executable="Salvo.exe"
                     EntryPoint="Windows.FullTrustApplication">
            <uap:VisualElements
                DisplayName="Salvo"
                Description="Coordinated, readiness-gated launcher for your Windows startup apps."
                Square150x150Logo="Images\Square150x150Logo.png"
                Square44x44Logo="Images\Square44x44Logo.png"
                BackgroundColor="transparent">
                <uap:DefaultTile
                    Wide310x150Logo="Images\Wide310x150Logo.png" />
                <uap:SplashScreen
                    Image="Images\SplashScreen.png"
                    BackgroundColor="#1F1F1F" />
            </uap:VisualElements>
            <Extensions>
                <!--
                  windows.startupTask: registers Salvo as a boot-startup
                  app via Windows' native Startup Apps mechanism (visible
                  + toggleable in Task Manager → Startup apps and
                  Settings → Apps → Startup), with no Run-key brittleness.
                  Enabled="false" by default — user opts in via the in-app
                  setting (which calls StartupTask.RequestEnableAsync) so
                  no surprise Run-on-Boot. When enabled, Windows treats
                  the launch as part of boot and may prefetch the package,
                  shaving ~1-3s of cold start vs the HKCU\Run path.

                  TaskId is the stable identifier we pass to
                  StartupTask.GetAsync; keep it constant across releases
                  or the user's "enabled" choice resets.
                -->
                <uap5:Extension Category="windows.startupTask">
                    <uap5:StartupTask
                        TaskId="SalvoStartup"
                        Enabled="false"
                        DisplayName="Salvo" />
                </uap5:Extension>
            </Extensions>
        </Application>
    </Applications>

    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>
</Package>
