<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Normalizes embedded source paths on CI so builds are reproducible;
         conditioned on the runner so local builds keep full paths for debugging. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Single Win10 floor (1809 / MSIX minimum) shared by every project, so
         CA1416 has one consistent platform baseline instead of Core defaulting
         lower than the WPF app. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Product>Salvo</Product>
    <Company>Salvo</Company>
    <!-- Fixed year (not UtcNow.Year) so the emitted assembly is source-determined,
         honoring Deterministic=true. -->
    <Copyright>Copyright (c) 2025 Salvo</Copyright>
    <Version>0.2.14</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AppId>salvo</AppId>
    <AppUpgradeCode>4A543774-32C7-42DD-888B-CF2FCE525267</AppUpgradeCode>
    <!-- Burn bundle UpgradeCode. Distinct from the MSI UpgradeCode above; never change. -->
    <AppBundleUpgradeCode>C1198714-85D8-48B7-A172-2B40B81F8873</AppBundleUpgradeCode>
    <AppSupportUrl>https://github.com/beelzer/salvo</AppSupportUrl>
    <AppAboutUrl>https://github.com/beelzer/salvo</AppAboutUrl>
  </PropertyGroup>
</Project>
